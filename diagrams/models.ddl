CREATE TABLE PLAYER (id varchar(36) NOT NULL, username varchar(50) NOT NULL UNIQUE, registration_date date NOT NULL, registration_time time(7) NOT NULL, email varchar(100) NOT NULL UNIQUE, PRIMARY KEY (id));
CREATE TABLE FRIENDSHIP_REQUEST (id varchar(36) NOT NULL, requester_id varchar(36) NOT NULL, reciver_id varchar(36) NOT NULL, request_ts timestamp NOT NULL, decision_ts timestamp, is_accepted bytea, PRIMARY KEY (id));
CREATE TABLE FRIENDSHIP (id varchar(36) NOT NULL, friend1 varchar(36) NOT NULL, friend2 varchar(36) NOT NULL, start_ts timestamp NOT NULL, end_ts timestamp, is_active bytea NOT NULL, PRIMARY KEY (id));
CREATE TABLE BLOCK (id varchar(36) NOT NULL, blocker_id varchar(36) NOT NULL, blocked_id varchar(36) NOT NULL, start_ts timestamp NOT NULL, end_ts timestamp, is_active bytea NOT NULL, PRIMARY KEY (id));
CREATE TABLE PVP_GAME_REQUEST (id varchar(36) NOT NULL, friendship_id varchar(36) NOT NULL, start_ts timestamp NOT NULL, end_ts timestamp, is_active bytea NOT NULL, is_accepted bytea, PRIMARY KEY (id));
CREATE TABLE PVP_GAME (id varchar(36) NOT NULL, game_request_id varchar(36) NOT NULL, start_ts timestamp NOT NULL, end_ts timestamp, is_active bytea NOT NULL, PRIMARY KEY (id));
CREATE TABLE PVE_GAME (id varchar(36) NOT NULL, player_id varchar(36) NOT NULL, PRIMARY KEY (id));
CREATE TABLE GAME (id varchar(36) NOT NULL, start_ts timestamp NOT NULL, end_ts timestamp, is_active bytea NOT NULL, is_white_on_turn bytea NOT NULL, PRIMARY KEY (id));
CREATE TABLE API_REQUEST (id varchar(36) NOT NULL, game_id varchar(36) NOT NULL, request_ts timestamp NOT NULL, from_player_id varchar(36) NOT NULL, piece_uid varchar(3) NOT NULL, y int4 NOT NULL, x int4 NOT NULL, was_valid bytea, PRIMARY KEY (id));
CREATE TABLE PIECE (game_id varchar(36) NOT NULL, piece_uid varchar(3) NOT NULL, y int4 NOT NULL, x int4 NOT NULL, PRIMARY KEY (game_id, piece_uid));
CREATE TABLE API_RESPONSE (id varchar(36) NOT NULL, api_request_id varchar(36) NOT NULL, status varchar(100) NOT NULL, PRIMARY KEY (id));
ALTER TABLE FRIENDSHIP_REQUEST ADD CONSTRAINT FKFRIENDSHIP450824 FOREIGN KEY (requester_id) REFERENCES PLAYER (id);
ALTER TABLE FRIENDSHIP_REQUEST ADD CONSTRAINT FKFRIENDSHIP871626 FOREIGN KEY (reciver_id) REFERENCES PLAYER (id);
ALTER TABLE FRIENDSHIP ADD CONSTRAINT FKFRIENDSHIP796756 FOREIGN KEY (friend1) REFERENCES PLAYER (id);
ALTER TABLE FRIENDSHIP ADD CONSTRAINT FKFRIENDSHIP796757 FOREIGN KEY (friend2) REFERENCES PLAYER (id);
ALTER TABLE BLOCK ADD CONSTRAINT FKBLOCK111128 FOREIGN KEY (blocker_id) REFERENCES PLAYER (id);
ALTER TABLE BLOCK ADD CONSTRAINT FKBLOCK528202 FOREIGN KEY (blocked_id) REFERENCES PLAYER (id);
ALTER TABLE PVP_GAME_REQUEST ADD CONSTRAINT FKPVP_GAME_R684324 FOREIGN KEY (friendship_id) REFERENCES FRIENDSHIP (id);
ALTER TABLE PVP_GAME ADD CONSTRAINT FKPVP_GAME298973 FOREIGN KEY (game_request_id) REFERENCES PVP_GAME_REQUEST (id);
ALTER TABLE PVP_GAME ADD CONSTRAINT FKPVP_GAME756191 FOREIGN KEY (id) REFERENCES GAME (id);
ALTER TABLE GAME ADD CONSTRAINT FKGAME677167 FOREIGN KEY (id) REFERENCES PVE_GAME (id);
ALTER TABLE PVE_GAME ADD CONSTRAINT FKPVE_GAME360506 FOREIGN KEY (player_id) REFERENCES PLAYER (id);
ALTER TABLE API_REQUEST ADD CONSTRAINT FKAPI_REQUES389279 FOREIGN KEY (game_id) REFERENCES GAME (id);
ALTER TABLE API_REQUEST ADD CONSTRAINT FKAPI_REQUES933818 FOREIGN KEY (from_player_id) REFERENCES PLAYER (id);
ALTER TABLE PIECE ADD CONSTRAINT FKPIECE298194 FOREIGN KEY (game_id) REFERENCES GAME (id);
ALTER TABLE API_REQUEST ADD CONSTRAINT FKAPI_REQUES965584 FOREIGN KEY (game_id, piece_uid) REFERENCES PIECE (game_id, piece_uid);
ALTER TABLE API_RESPONSE ADD CONSTRAINT FKAPI_RESPON567273 FOREIGN KEY (api_request_id) REFERENCES API_REQUEST (id);
